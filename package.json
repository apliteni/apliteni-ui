{
  "name": "@apliteni/apliteni-ui",
  "version": "0.2.4",
  "description": "Apliteni shared design system & UI kit — tokens, components and the deck theme, framework-agnostic (HTML + CSS).",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Apliteni",
  "homepage": "https://ui.apli.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apliteni/apliteni-ui.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./inline": "./src/inline.js",
    "./css": "./src/index.css",
    "./tokens": "./src/tokens/tokens.css",
    "./accents": "./src/tokens/accents.css"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/html": "^8.6.14",
    "@storybook/html-vite": "^10.5.3",
    "storybook": "^8.6.14",
    "vite": "^8.1.5"
  }
}
