{
  "name": "@apliteni/apliteni-ui",
  "version": "0.7.2",
  "workspaces": ["react"],
  "description": "Apliteni shared design system & UI kit — tokens, components and the deck theme, framework-agnostic (HTML + CSS).",
  "type": "module",
  "license": "MIT",
  "author": "Apliteni",
  "homepage": "https://ui.apli.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apliteni/apliteni-ui.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./motion": "./src/motion.js",
    "./inline": "./src/inline.js",
    "./css": "./src/index.css",
    "./tokens": "./src/tokens/tokens.css",
    "./accents": "./src/tokens/accents.css",
    "./brand": "./src/tokens/brand.generated.css",
    "./react": {
      "types": "./react/dist/index.d.ts",
      "import": "./react/dist/index.js"
    },
    "./react/css": "./react/dist/index.css"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "react/dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "build": "npm run build --workspace react",
    "prepack": "npm run build",
    "test": "node --test $(find src stories site scripts -name '*.test.js')",
    "tokens:sync": "node scripts/sync-brand-tokens.mjs",
    "tokens:check": "node scripts/sync-brand-tokens.mjs --check",
    "tokens:drift": "node scripts/brand-drift.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/html-vite": "^10.5.5",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.5",
    "vite": "^8.2.0"
  }
}
