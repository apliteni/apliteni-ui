#!/bin/sh
# check-lock runs one command while holding this machine's single check lock, so two test suites
# never run at once: a second run waits, says so, and starts when the first one finishes.
#
# Copied from amberstone's scripts/check-lock at fb80a4252856f6bb645a8d46b1e7a634b57b5cfd. The lock
# path is the org-wide one, the variables lose their AMBER_ prefix, and the updater reservation is
# left out, as the org rule allows. The locking itself is unchanged.
set -eu

# One path outside any checkout, shared by every repository on the machine. A test of the lock
# points CHECK_LOCK at a directory of its own.
LOCK_DIR="${CHECK_LOCK:-$HOME/.check-lock}"
POLL_SECONDS="${CHECK_LOCK_POLL_SECONDS:-3}"
# A lock with no pid in it yet was created this moment; it is left alone for this many rounds.
UNNAMED_ROUNDS=5

if [ "$#" -eq 0 ]; then
	echo "usage: check-lock <command> [argument...]" >&2
	exit 2
fi

# A nested call, when a locked command itself runs one of the test scripts, must not wait for the
# lock its own caller holds, so it runs straight through.
if [ -n "${CHECK_LOCK_HELD_BY:-}" ]; then
	exec "$@"
fi

# The lock is a directory because macOS has no flock(1), and mkdir is atomic: of two runs racing for
# a free lock, exactly one creates it. The holder writes its pid and start time inside. A pid alone
# does not identify a process for good, because the system reuses the numbers; the start time ties
# the pid to one process, so a lock whose pid is dead, or now belongs to another process, is stale.
start_time_of() {
	ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//;s/ *$//'
}

# A pid equal to this run's own is never live: a waiting run cannot already hold the lock, so the
# number was reused. A lock written before start times were recorded is judged by its pid alone.
holder_is_live() {
	[ "$1" != "$$" ] || return 1
	kill -0 "$1" 2>/dev/null || return 1
	[ -z "$2" ] || [ "$2" = "$(start_time_of "$1")" ]
}

# A stale lock is renamed away, not removed in place: two runs removing and recreating the same
# lock at once, or a run removing a lock that changed hands since it read the pid, would each leave
# two suites running. The takeover stands only if the pid and start time inside are still the ones
# this run judged stale; otherwise the lock goes straight back.
take_over() {
	stale="$LOCK_DIR.stale.$$"
	mv "$LOCK_DIR" "$stale" 2>/dev/null || return 1
	if [ "$(cat "$stale/pid" 2>/dev/null || echo "")" != "$1" ] ||
		[ "$(cat "$stale/started" 2>/dev/null || echo "")" != "$2" ]; then
		mv "$stale" "$LOCK_DIR" 2>/dev/null || rm -rf "$stale"
		return 1
	fi
	rm -rf "$stale"
}

# Releasing always succeeds, so it never becomes the exit status of the check.
release_lock() {
	rm -rf "$LOCK_DIR"
	return 0
}

mkdir -p "$(dirname "$LOCK_DIR")"
said=no
told=no
unnamed=0
rounds=0
until mkdir "$LOCK_DIR" 2>/dev/null; do
	pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
	started=$(cat "$LOCK_DIR/started" 2>/dev/null || echo "")
	if [ -z "$pid" ] && [ "$unnamed" -lt "$UNNAMED_ROUNDS" ]; then
		unnamed=$((unnamed + 1))
	elif [ -n "$pid" ] && holder_is_live "$pid" "$started"; then
		if [ "$said" = no ]; then
			echo "check-lock: another check is running on this machine (pid $pid); waiting for it to finish." >&2
			said=yes
		fi
		unnamed=0
	else
		if [ "$told" = no ]; then
			echo "check-lock: the check holding the lock is gone (pid ${pid:-unknown}); taking it over." >&2
			told=yes
		fi
		take_over "$pid" "$started" || true
		unnamed=0
	fi
	sleep "$POLL_SECONDS"
	rounds=$((rounds + 1))
done

# Ctrl-C and kill become an ordinary exit so the release runs; only SIGKILL and a crash get past it,
# and the takeover above is for those. The start time goes in first, so a waiter that can read a pid
# finds the start time beside it.
trap release_lock EXIT
trap 'exit 1' HUP INT TERM
start_time_of $$ >"$LOCK_DIR/started"
echo $$ >"$LOCK_DIR/pid"
if [ "$said" = yes ]; then
	echo "check-lock: the lock is free after ${rounds} rounds of ${POLL_SECONDS}s; starting this check now." >&2
fi

CHECK_LOCK_HELD_BY=$$
export CHECK_LOCK_HELD_BY
"$@"
